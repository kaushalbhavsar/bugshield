<div class="col-md-12 col-sm-12 col-sx-12">
    <div class="panel panel-default">

        <div class="panel-body">
            <div class="table-responsive">

                <table class="table table-condensed table-striped table-bordered table-hover no-margin">
                    <tr class="panel-heading">



                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.TimeSortParm , currentFilter=ViewBag.CurrentFilter})"><h4>Time <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>

                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.SourceSortParm , currentFilter=ViewBag.CurrentFilter })"><h4>Attack Source   <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>



                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.MethodSortParm , currentFilter=ViewBag.CurrentFilter })"><h4>Method  <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>

                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.UrlSortParm,currentFilter=ViewBag.CurrentFilter })"><h4>URL  <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>

                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.HostSortParm,currentFilter=ViewBag.CurrentFilter })"><h4>Host  <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>

                        <th>
                            <div class="panel-heading">
                                <a href="@Url.Action("Index", new { sortOrder = ViewBag.AttackidSortParm,currentFilter=ViewBag.CurrentFilter })"><h4>Type  <i class="glyphicon glyphicon-sort"></i></h4></a>
                            </div>
                        </th>
                        <th>
                            <div class="panel-heading">
                                <h4>Attack Type</h4>
                            </div>
                        </th>
                    </tr>


                    @foreach (var item in Model)
                    {

                        <tr class="table table-condensed table-striped table-bordered table-hover no-margin">

                            <td>
                                @Html.DisplayFor(modelItem => item.Time)
                            </td>
                            <td>
                                <a href="@Url.Action("DetailsIP","ShieldLogs", new {SourceIp= item.SourceIp, searchString=item.Host})">
                                    @Html.DisplayFor(modelItem => item.SourceIp)
                                </a>
                                <br />



                                @{
                                    if (item.IpInfo != null)
                                    {

                                        CityResponse city = (CityResponse)JsonConvert.DeserializeObject<CityResponse>(item.IpInfo);



                                        @:<p><span class="flag-icon flag-icon-@city.Country.IsoCode.ToLower()"></span> @city.Country.Name </p>
                            Html.Display(city.Country.Name);
                                    }

                                    else
                                    {

                                    }
                                }
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Method)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Url)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Host)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.ResponseCode)
                            </td>

                            <td>

                                @*Added relationship to Attack Database*@
                                @Html.DisplayFor(modelItem => item.BugDB.Title)
                            </td>
                            <td>

                                <a href="@Url.Action("Details",new { id=item.id } )" class="btn btn-default"><i class="glyphicon glyphicon-eye-open"></i> Details</a>


                            </td>
                        </tr>
                                    }

                </table>
            </div>
        </div>
    </div>
</div>



<br />
        Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

        @Html.PagedListPager(Model, page => Url.Action("Index",
    new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))