<p>
    <a href="@Url.Action("Index", "ShieldLogs",new { searchString = ViewBag.SearchString })" class="btn btn-primary"><i class="glyphicon glyphicon-backward"></i> Back to List</a>
    @*<a href="@Url.Action("Index")" class="btn btn-default">Back to List</a>
        @Html.ActionLink("Back to List", "Index")*@
