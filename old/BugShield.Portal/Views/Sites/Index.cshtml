    @model IEnumerable<BugShield.Portal.Models.Site>

@{
    ViewBag.Title = "My Sites";
}


<p>

    <a href="@Url.Action("Create")" class="btn btn-default"  >Add new Website</a>
    @*<button type="button"  data-original-title>@Html.ActionLink("Add new Website", "Create")</button>*@
</p>

        <div class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="content">
                                <div class="toolbar">
                                    <!--        Here you can write extra buttons/actions for the toolbar              -->
                                </div>
                                <div class="material-datatables">
                                    <table id="datatables" class="table table-striped table-no-bordered table-hover" style="width:100%;cellspacing:0">
                                        <thead>
                                            <tr>
                                                <th>@Html.DisplayNameFor(model => model.Name)</th>
                                                <th>@Html.DisplayNameFor(model => model.Url)</th>
                                                <th>@Html.DisplayNameFor(model => model.IPAddress)</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Url)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IPAddress)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.IPAddress)</td>
                                                    <td class="text-right">
                                                        <a href="@Url.Action("Edit", new { id = item.SiteId })" class="btn btn-primary"><i class="glyphicon glyphicon-edit"></i> Edit</a>

                                                        <a href="@Url.Action("Index", "ShieldLogs", new { searchString = item.Url })" class="btn btn-warning"><i class="glyphicon glyphicon-eye-open"></i> View</a>

                                                        <a href="@Url.Action("Index", "Home", new { host = item.Url })" class="btn btn-primary"><i class="glyphicon glyphicon-edit"></i> Graph</a>

                                                        Html.ActionLink("Edit", "Edit", new { id = item.SiteId }) |
                                                        @Html.ActionLink("View Logs", "Index", "ShieldLogs", new { searchString = item.Url }, null)
                                                        @*<a href="#" class="btn btn-simple btn-info btn-icon like"><i class="ti-heart"></i></a>
                                                            <a href="#" class="btn btn-simple btn-warning btn-icon edit"><i class="ti-pencil-alt"></i></a>*@
                                                        @*<a href="#" class="btn btn-simple btn-danger btn-icon remove"><i class="ti-close"></i></a>*@
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
        </div>
   

