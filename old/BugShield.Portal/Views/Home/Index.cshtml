                <td> @Html.DropDownList("host", (List<SelectListItem>)ViewBag.ListofHosts, "ABC", new { @class = "btn btn-info dropdown-toggle form-control" })</td>
                <td><h6>Date:</h6></td>
                <td><input class="datefield form-control" data-val="true" data-val-required="Date is required" id="DateforChart" name="DateforChart" type="date" value="1/11/1989" /></td>
                <td><input type="submit" class="btn btn-primary form-control" placeholder="Search" value="Search" /></td>
            </tr>
            @*<ul class="dropdown-menu sm fadeInUp animated messages form-control">
