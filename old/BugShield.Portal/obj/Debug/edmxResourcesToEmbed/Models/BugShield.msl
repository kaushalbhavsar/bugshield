    <FunctionImportMapping FunctionImportName="Rpt_AttackTypeByHost" FunctionName="BugSkanDBModel.Store.Rpt_AttackTypeByHost">
      <ResultMapping>
        <ComplexTypeMapping TypeName="BugSkanDBModel.Rpt_AttackTypeByHost_Result">
          <ScalarProperty Name="attackid" ColumnName="attackid" />
