          <ScalarProperty Name="Date" ColumnName="Date" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <FunctionImportMapping FunctionImportName="Rpt_AttackCountByDate" FunctionName="BugSkanDBModel.Store.Rpt_AttackCountByDate">
      <ResultMapping>
        <ComplexTypeMapping TypeName="BugSkanDBModel.AttackByDate">
          <ScalarProperty Name="date" ColumnName="date" />
