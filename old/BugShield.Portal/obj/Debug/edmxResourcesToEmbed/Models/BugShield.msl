          <ScalarProperty Name="PaymentDueDate" ColumnName="PaymentDueDate" />
          <ScalarProperty Name="PaymentDate" ColumnName="PaymentDate" />
          <ScalarProperty Name="PaymentPending" ColumnName="PaymentPending" />
          <ScalarProperty Name="PaymentMade" ColumnName="PaymentMade" />
          <ScalarProperty Name="EndDate" ColumnName="EndDate" />
          <ScalarProperty Name="StartDate" ColumnName="StartDate" />
          <ScalarProperty Name="PlanName" ColumnName="PlanName" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Sites">
      <EntityTypeMapping TypeName="BugSkanDBModel.Site">
        <MappingFragment StoreEntitySet="Site">
          <ScalarProperty Name="PlanName" ColumnName="PlanName" />
          <ScalarProperty Name="Server" ColumnName="Server" />
          <ScalarProperty Name="IPAddress" ColumnName="IPAddress" />
          <ScalarProperty Name="LoginSuccess" ColumnName="LoginSuccess" />
          <ScalarProperty Name="LoginUrl" ColumnName="LoginUrl" />
          <ScalarProperty Name="UserId" ColumnName="UserId" />
          <ScalarProperty Name="Technology" ColumnName="Technology" />
          <ScalarProperty Name="LoginPass" ColumnName="LoginPass" />
          <ScalarProperty Name="LoginUser" ColumnName="LoginUser" />
          <ScalarProperty Name="Notes" ColumnName="Notes" />
          <ScalarProperty Name="Status" ColumnName="Status" />
          <ScalarProperty Name="LastScan" ColumnName="LastScan" />
          <ScalarProperty Name="AddedDate" ColumnName="AddedDate" />
          <ScalarProperty Name="Url" ColumnName="Url" />
          <ScalarProperty Name="Name" ColumnName="Name" />
          <ScalarProperty Name="SiteId" ColumnName="SiteId" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="BugDBs">
      <EntityTypeMapping TypeName="BugSkanDBModel.BugDB">
        <MappingFragment StoreEntitySet="BugDB">
          <ScalarProperty Name="TimeStamp" ColumnName="TimeStamp" />
          <ScalarProperty Name="VideoUrl" ColumnName="VideoUrl" />
          <ScalarProperty Name="Links" ColumnName="Links" />
          <ScalarProperty Name="Description" ColumnName="Description" />
          <ScalarProperty Name="Title" ColumnName="Title" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="ShieldLogs">
      <EntityTypeMapping TypeName="BugSkanDBModel.ShieldLog">
        <MappingFragment StoreEntitySet="ShieldLog">
          <ScalarProperty Name="IpInfo" ColumnName="IpInfo" />
          <ScalarProperty Name="AttackId" ColumnName="AttackId" />
          <ScalarProperty Name="ResponseCode" ColumnName="ResponseCode" />
