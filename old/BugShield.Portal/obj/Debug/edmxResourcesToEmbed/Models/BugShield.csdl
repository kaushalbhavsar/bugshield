    <Property Name="Technology" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="UserId" Type="String" MaxLength="Max" FixedLength="false" Unicode="true" />
    <Property Name="LoginUrl" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="LoginSuccess" Type="String" MaxLength="10" FixedLength="true" Unicode="true" />
    <Property Name="IPAddress" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="Server" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="PlanName" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
  </EntityType>
  <EntityType Name="BugDB">
