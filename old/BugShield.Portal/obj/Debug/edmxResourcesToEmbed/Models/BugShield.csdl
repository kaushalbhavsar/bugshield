  </EntityType>
  <Association Name="FK_ShieldLog_BugDB">
    <End Type="BugSkanDBModel.BugDB" Role="BugDB" Multiplicity="0..1" />
    <End Type="BugSkanDBModel.ShieldLog" Role="ShieldLog" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="BugDB">
        <PropertyRef Name="Id" />
      </Principal>
      <Dependent Role="ShieldLog">
        <PropertyRef Name="AttackId" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <ComplexType Name="Rpt_AttackCountByDate_Result">
    <Property Type="DateTime" Name="date" Nullable="true" Precision="23" />
