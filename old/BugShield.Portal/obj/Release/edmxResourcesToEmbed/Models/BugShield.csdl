    <Property Name="UserAgent" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="PostData" Type="String" MaxLength="Max" FixedLength="false" Unicode="false" />
    <Property Name="ResponseCode" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="AttackId" Type="Int32" />
