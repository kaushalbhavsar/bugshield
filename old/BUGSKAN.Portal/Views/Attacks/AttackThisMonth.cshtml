@model PagedList.IPagedList<BUGSKAN.Portal.Models.ShieldLog>
@using PagedList.Mvc;
@using Newtonsoft.Json;
@using MaxMind.GeoIP2.Responses;
@using BUGSKAN.Portal.Models;
@using Microsoft.AspNet.Identity;

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
<link href="~/css/flag-icon.css" rel="stylesheet" type="text/css" />
@{
    Layout = "~/Views/Shared/_Inner.cshtml";
    ViewBag.Title = "Attacks blocked in last month";
}


<div class="col-md-12">
    <h4 class="title">@Model.Count attacks blocked on <b>@HttpContext.Current.Session["CurrentSite"].ToString()</b> in <b>this month </b></h4>
</div>
<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="content">

                        <table id="datatables" class="table table-striped table-responsive table-no-bordered table-hover" style="width:100%; cellspacing:0">
                            <thead>
                                <tr>
                                    <th class="col1"><a href="@Url.Action("AttackThisMonth", new { sortOrder = ViewBag.TimeSortParm , currentFilter=ViewBag.CurrentFilter})"><h5>Time <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th class="col1"><a href="@Url.Action("AttackThisMonth", new { sortOrder = ViewBag.SourceSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Source   <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th class="col1"><a href="@Url.Action("AttackThisMonth", new { sortOrder = ViewBag.MethodSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Method  <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th class="col1"><a href="@Url.Action("AttackThisMonth", new { sortOrder = ViewBag.UrlSortParm,currentFilter=ViewBag.CurrentFilter })"><h5>URL  <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th><a href="@Url.Action("AttackThisMonth", new { sortOrder = ViewBag.DescriptionSortParm,currentFilter=ViewBag.CurrentFilter })"><h5>Description  <i class="glyphicon glyphicon-sort"></i></h5></a></th>

                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {


                                    <tr>
                                        <td style="width:200px;">
                                            @Html.DisplayFor(modelItem => item.Time)
                                        </td>
                                        <td style="width:120px;">
                                            <a href="@Url.Action("DetailsIPForMonth", "Attacks", new { SourceIp = item.SourceIp, searchString = item.Host })">
                                                @Html.DisplayFor(modelItem => item.SourceIp)
                                            </a>
                                            <br />
                                            @{
                                                if (item.IpInfo != null)
                                                {

                                                    CityResponse city = (CityResponse)JsonConvert.DeserializeObject<CityResponse>(item.IpInfo);
                                                    @:<p><span style="white-space: nowrap;"><span class="flag-icon flag-icon-@city.Country.IsoCode.ToLower()"></span> @city.Country.Name </span></p>@Html.Display(city.Country.Name)
                                                    }

                                                else
                                                {

                                                }
                                            }
                                        </td>
                                        <td style="width:8px;">@Html.DisplayFor(modelItem => item.Method)</td>
                                        <td style="width:300px;" class="wrappedcell">@Html.DisplayFor(modelItem => item.Url)</td>

                                        <td class="wrappedcell">@*Added relationship to Attack Database*@@Html.DisplayFor(modelItem => item.BugDB.Title)</td>
                                        <td><a href="@Url.Action("DetailsForMonth", new { id = item.id })" class="btn btn-default"><i class="ti-arrow-right"></i></a></td>
                                    </tr>

                                                }
                                <tr>
                                    <div class="col1" style="text-align:center"><b><h4>@Session["NoAttacksMonth"]</h4></b></div>
                                </tr>
                        </table>
                    </div>
                </div>
                <!-- end content-->
            </div>
            <!--  end card  -->
        </div>
        <!-- end col-md-12 -->
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="text-center">
            Displaying page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

            @Html.PagedListPager(Model, page => Url.Action("AttackThisMonth",
    new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
        </div>

    </div>
</div>












