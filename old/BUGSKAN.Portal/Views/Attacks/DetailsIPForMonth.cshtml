                                    type: 'category',

                                    labels: {
                                        formatter: function () {
                                            var text = this.value,
                                                formatted = text.length > 25 ? text.substring(0, 25) + '...' : text;

                                            return '<div class="js-ellipse" style="width:150px; overflow:hidden" title="' + text + '">' + formatted + '</div>';
                                        },
