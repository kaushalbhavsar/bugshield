</div>

<div class="content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-md-6">

            </div>

            <div class="col-md-6">

            </div>

        </div>
        <div class="row">

            <div class="col-md-12">
                <h4>Details of attacks</h4>
                <div class="card">
                    <div class="content">

                        <table id="datatables" class="table table-striped table-no-bordered table-hover" style="width:100%;cellspacing:0">
                            <thead>
                                <tr>
                                    <th>
                                        <div>
                                            <a href="@Url.Action("Index", new { sortOrder=ViewBag.TimeSortParm , currentFilter=ViewBag.CurrentFilter})"><h5>Time <i class="glyphicon glyphicon-sort"></i></h5></a>
                                        </div>
                                    </th>

                                    <th>
                                        <div>
                                            <a href="@Url.Action("Index", new { sortOrder=ViewBag.MethodSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Method  <i class="glyphicon glyphicon-sort"></i></h5></a>
                                        </div>
                                    </th>

                                    <th>
                                        <div>
                                            <a href="@Url.Action("Index", new { sortOrder=ViewBag.UrlSortParm,currentFilter =ViewBag.CurrentFilter })"><h5>URL  <i class="glyphicon glyphicon-sort"></i></h5></a>
                                        </div>
                                    </th>

                                    @*
                                        <th>
                                            <div>
                                                <a href="@Url.Action(" Index", new { sortOrder=ViewBag.HostSortParm,currentFilter =ViewBag.CurrentFilter })"><h5>Host  <i class="glyphicon glyphicon-sort"></i></h5></a>
                                            </div>
                                        </th>*@

                                    <th>
                                        <div>
                                            <a href="@Url.Action("Index", new { sortOrder=ViewBag.AttackidSortParm,currentFilter =ViewBag.CurrentFilter })"><h5>Description  <i class="glyphicon glyphicon-sort"></i></h5></a>
                                        </div>
                                    </th>

                                    <th>

                                    </th>
                                </tr>
                                @foreach (var item in Model)
                                {

                                    <tr class="table table-condensed table-striped table-bordered table-hover no-margin">

                                        <td>
                                            @Html.DisplayFor(modelItem => item.Time)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Method)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Url)
                                        </td>

                                        <td>

                                            @*Added relationship to Attack Database*@
                                            @Html.DisplayFor(modelItem => item.BugDB.Title)
                                        </td>
                                        <td><a href="@Url.Action("DetailsForMonth", new { id=item.id })" class="btn btn-default"><i class="ti-arrow-right"></i></a></td>

                                    </tr>
                                }

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<p>
