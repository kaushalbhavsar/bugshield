@model PagedList.IPagedList<BUGSKAN.Portal.Models.ShieldLog>
@using PagedList.Mvc;
@using Newtonsoft.Json;
@using MaxMind.GeoIP2.Responses;
@using BUGSKAN.Portal.Models;
@using Microsoft.AspNet.Identity;

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
<link href="~/css/flag-icon.css" rel="stylesheet" type="text/css" />
@{
    Layout = "~/Views/Shared/_Inner.cshtml";
    ViewBag.Title = "Attacks blocked today";
}


<div class="col-md-12">
    <h4 class="title">@Model.Count attacks blocked on <b>@HttpContext.Current.Session["CurrentSite"].ToString()</b> in last <b>24 hours</b> </h4>
</div>
<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">


                <div class="card">
                    <div class="content">
                        Sort by <a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.TimeSortParm , currentFilter=ViewBag.CurrentFilter})"><div class="btn btn-primary btn-sm"><i class="ti ti-time"></i> Time of attack </div></a>
                        <a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.SourceSortParm , currentFilter=ViewBag.CurrentFilter })"><div class="btn btn-success btn-sm"><i class="ti ti-world"></i> Source of attack </div></a>

                        <a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.MethodSortParm , currentFilter=ViewBag.CurrentFilter })"><div class="btn btn-danger btn-sm"><i class="ti ti-direction"></i> Request type </div></a>
                        <a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.UrlSortParm,currentFilter =ViewBag.CurrentFilter })"><div class="btn btn-info btn-sm"><i class="ti ti-link"></i> Url attacked </div></a>
                        <a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.DescriptionSortParm,currentFilter =ViewBag.CurrentFilter })"><div class="btn btn-warning btn-sm"><i class="ti ti-bolt"></i> Type of attack</div></a>

                        <div>






                            <table id="datatables" class="table table-striped table-responsive table-no-bordered table-hover" style="width:100%;cellspacing:0">
                                <thead>
                                    <tr>
                                        <th class="col1"><a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.TimeSortParm , currentFilter=ViewBag.CurrentFilter})"><h5>Time <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                        <th class="col1"><a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.SourceSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Source   <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                        <th class="col1"><a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.MethodSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Method  <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                        <th class="col1"><a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.UrlSortParm,currentFilter =ViewBag.CurrentFilter })"><h5>URL  <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                        <th><a href="@Url.Action("AttackToday", new { sortOrder=ViewBag.DescriptionSortParm,currentFilter =ViewBag.CurrentFilter })"><h5>Description  <i class="glyphicon glyphicon-sort"></i></h5></a></th>

                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {


                                        <tr>


                                            <td style="width:100px;">

                                                @{

                                                    DateTime refDate = (DateTime)item.Date + ((DateTime)item.Time).TimeOfDay;

                                                    DateTime curDate = DateTime.UtcNow;

                                                    TimeSpan epoch = curDate - refDate;

                                                    if (epoch.Days > 0)
                                                    {

                                                        if (epoch.Days == 1)
                                                        {
                                                @:<span> @epoch.Days.ToString() day ago</span>
                                            }
                                                        else
                                                        {
                                                @:<span> @epoch.Days.ToString() days ago</span>
                                            }

                                                    }
                                                    else if (epoch.Hours > 0)
                                                    {
                                                        if (epoch.Hours == 1)
                                                        {
                                                @:<span> @epoch.Hours.ToString() hour ago</span>
                                            }
                                                        else
                                                        {
                                                @:<span> @epoch.Hours.ToString() hours ago</span>
                                            }

                                                    }

                                                    else
                                                    {

                                                @:<span> @epoch.Minutes.ToString() minutes ago</span>
                                            }

                                                }


                                            </td>


                                            <td style="width:8px;">
                                                @{

                                                    switch (item.Method)
                                                    {
                                                        case "POST":
                                                            {
                                                @:<span class="label label-danger"><span class="glyphicon glyphicon-arrow-right"> Post</span></span>
                                            break;
                                                            }
                                                        case "GET":
                                                            {
                                                @:<span class="label label-success"><span class="glyphicon glyphicon-arrow-right"> Get</span></span>
                                            break;
                                                            }


                                                        case "HEAD":
                                                            {
                                                @:<span class="label label-info"><span class="glyphicon glyphicon-arrow-right"> Head</span></span>
                                            break;
                                                            }

                                                        case "PUT":
                                                            {
                                                @:<span class="label label-warning"><span class="glyphicon glyphicon-arrow-right"> Put</span></span>
                                            break;
                                                            }
                                                        default:
                                                            {
                                                @:<span class="label label-danger"> @item.Method</span> ;
                                            break;

                                                            }
                                                    }


                                                }

                                            </td>
                                            <td class="wrappedcell">@*Added relationship to Attack Database*@ @Html.DisplayFor(modelItem => item.BugDB.Title)</td>



                                            <td style="width:300px;">@Html.DisplayFor(modelItem => item.Url)</td>
                                            <td style="width:120px;">
                                                <a href="@Url.Action(" DetailsIPForToday", "Attacks", new { SourceIp = item.SourceIp, searchString = item.Host })">
                                                    @Html.DisplayFor(modelItem => item.SourceIp)
                                                </a>
                                                <br />
                                                @{
                                                    if (item.IpInfo.ToUpper() != "NULL")
                                                    {

                                                        CityResponse city = (CityResponse)JsonConvert.DeserializeObject<CityResponse>
                                                            (item.IpInfo);
                                                @:<p><span style="white-space: nowrap;"><span class="flag-icon flag-icon-@city.RegisteredCountry.IsoCode.ToLower()"></span> @city.RegisteredCountry.Name </span></p>@*@Html.Display(city.RegisteredCountry.Name)*@
                                                }

                                                    else
                                                    {

                                                    }
                                                }
                                            </td>

                                            @*
                                                <td><a href="@Url.Action(" DetailsForToday", new { id=item.id })" class="btn btn-default"><i class="ti-arrow-right"></i></a></td>*@


                                            <td style="width:8px;">


                                                <button type="button" class="btn btn-info btn-fab btn-fab-mini btn-fill" data-toggle="modal" data-target=".modal-@item.id"><i class="ti ti-eye"></i></button>

                                                <div class="modal fade modal-@item.id" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel">
                                                    <div class="modal-dialog modal-lg" role="document">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h4 class="modal-title" id="myLargeModalLabel">@item.BugDB.Title</h4>
                                                            </div>
                                                            <div class="modal-body" style="height:300px;">

                                                                <div class="content">
                                                                    <div class="col-md-12">

                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">Time</label>
                                                                                <div class="col-sm-10">

                                                                                    <span>@( (DateTime)item.Date + ((DateTime)item.Time).TimeOfDay)</span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>

                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">Source</label>
                                                                                <div class="col-sm-10">

                                                                                    <span>
                                                                                        @item.SourceIp
                                                                                        @{
                                                                                            if (item.IpInfo != null)
                                                                                            {

                                                                                                CityResponse city = (CityResponse)JsonConvert.DeserializeObject<CityResponse>
                                                                                                    (item.IpInfo);
                                                                                        @:<p><span style="white-space: nowrap;"><span class="flag-icon flag-icon-@city.RegisteredCountry.IsoCode.ToLower()"></span> @city.RegisteredCountry.Name </span></p>@*@Html.Display(city.RegisteredCountry.Name)*@
                                                                                    }

                                                                                            else
                                                                                            {

                                                                                            }
                                                                                        }
                                                                                    </span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>
                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">Method</label>
                                                                                <div class="col-sm-10">

                                                                                    <span>@item.Method</span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>
                                                                       
                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">Url</label>
                                                                                <div class="col-sm-10">

                                                                                    <span><code>@item.Host:@item.DestPort@item.Url</code></span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>
                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">User Agent</label>
                                                                                <div class="col-sm-10">

                                                                                    <span>@item.UserAgent</span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>
                                                                        <fieldset>
                                                                            <div class="form-group">
                                                                                <label class="col-sm-2 control-label">Post Data</label>
                                                                                <div class="col-sm-10">

                                                                                    <span>
                                                                                        @{
                                                                                            var newPostData = item.PostData;
                                                                                            String PostData = newPostData.Replace("\\n", Environment.NewLine);

                                                                                        @:<pre class="prettyprint">@PostData</pre>








                                                                                        }
                                                                                    </span>
                                                                                </div>
                                                                            </div>
                                                                        </fieldset>

                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">

                                                                <button type="button" class="btn btn-info" data-dismiss="modal">
                                                                    Close
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>




                                        </tr>
                                                                                            }

                                    <tr>
                                        <div class="col1" style="text-align:center"><b><h4>@Session["NoAttacksToday"]</h4></b></div>
                                    </tr>

                                </tbody>



                            </table>




                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="text-center">
                    Displaying page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

                    @Html.PagedListPager(Model, page => Url.Action("AttackToday",
                new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))
                </div>

            </div>
        </div>












