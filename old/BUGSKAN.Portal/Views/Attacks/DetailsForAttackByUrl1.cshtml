@model PagedList.IPagedList<BUGSKAN.Portal.Models.Rpt_AttackByURLDetails_Result>
@using PagedList.Mvc;
@using Newtonsoft.Json;
@using MaxMind.GeoIP2.Responses;
@using BUGSKAN.Portal.Models;
@using Microsoft.AspNet.Identity;

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
<link href="~/css/flag-icon.css" rel="stylesheet" type="text/css" />
@{
    Layout = "~/Views/Shared/_Inner.cshtml";
    ViewBag.title = "Attacks By URL";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="content">

                        <table id="datatables" class="table table-striped table-responsive table-no-bordered table-hover" style="width:100%;cellspacing:0">
                            <thead>
                                <tr>
                                    <th><a href="@Url.Action("DetailsForAttackByUrl1", new { sortOrder = ViewBag.TimeSortParm, currentFilter = ViewBag.CurrentFilter })}"><h5>Time <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th><a href="@Url.Action("DetailsForAttackByUrl1", new { sortOrder = ViewBag.SourceSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Source   <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                    <th><a href="@Url.Action("DetailsForAttackByUrl1", new { sortOrder = ViewBag.ResponseCodeSortParm , currentFilter=ViewBag.CurrentFilter })"><h5>Response Code  <i class="glyphicon glyphicon-sort"></i></h5></a></th>
                                </tr>
                              </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.time)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.sourceip)
                                            <br />

                                            @{
                                                if (item.ipinfo != null)
                                                {

                                                    CityResponse city = (CityResponse)JsonConvert.DeserializeObject<CityResponse>(item.ipinfo);
                                                    @:<p><span style="white-space: nowrap;"><span class="flag-icon flag-icon-@city.Country.IsoCode.ToLower()"></span> @city.Country.Name </span></p>@Html.Display(city.Country.Name)
                                                    }

                                                else
                                                {

                                                }
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.responsecode)</td>
                                       
                                    </tr>

                                                }



                        </table>
                        <a href="@Url.Action("AttackByUrl")" class="btn btn-default"><i class="glyphicon glyphicon-eye-open"></i> Back to list</a></td>

                    </div>
                </div>
                <!-- end content-->
            </div>
            <!--  end card  -->
        </div>
        <!-- end col-md-12 -->
    </div>
</div>

Displaying page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount

@Html.PagedListPager(Model, page => Url.Action("DetailsForAttackByUrl1",
    new { page, sortOrder = ViewBag.CurrentSort, currentFilter = ViewBag.CurrentFilter }))