@model BUGSKAN.Portal.Models.RegisterViewModel

@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Register.cshtml";

}
<html>
<body>

    <div class="wrapper wrapper-full-page">
        <div class="register-page">
            <!--   you can change the color of the filter page using: data-color="blue | azure | green | orange | red | purple" -->
            <div class="content">
                <div class="container">
                    <div class="row">
                        <div class="col-md-8 col-md-offset-2">
                            <div class="header-text">
                                <img src="/assets/img/logo.png" width="180" style="width:300px;" />
                                <h4>Hack proof your website INSTANTLY.</h4>
                                <hr>
                            </div>
                        </div>
                        <div class="col-md-4 col-md-offset-2">
                            <div class="media">
                                <div class="media-left">
                                    <div class="icon icon-danger">
                                        <i class="ti ti-shield"></i>
                                    </div>
                                </div>
                                <div class="media-body">
                                    <h5>Realtime Protection</h5>
                                    Stop hackers before they reach your website.
                                </div>
                            </div>
                            <div class="media">
                                <div class="media-left">
                                    <div class="icon icon-warning">
                                        <i class="ti-search"></i>
                                    </div>
                                </div>
                                <div class="media-body">
                                    <h5>Security Scanning</h5>
                                    Discover security weaknesses in your website
                                </div>
                            </div>
                            <div class="media">
                                <div class="media-left">
                                    <div class="icon icon-info">
                                        <i class="ti-bolt"></i>
                                    </div>
                                </div>
                                <div class="media-body">
                                    <h5>Instant Activation</h5>
                                    Get secure instantly. No installation required!
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                            {

                                @Html.AntiForgeryToken()
                                @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
                                <div class="card card-plain">
                                    <div class="content">

                                        <div class="form-group">


                                            <div class="col-md-10">
                                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Your email" })
                                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "error" })
                                                <div class="text-danger">
                                                    @ViewBag.EmailErrorMsg
                                                </div>
                                            </div>

                                        </div>
                                        <div class="form-group">
                                            <div class="col-md-10">
                                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password" })
                                                @Html.ValidationMessageFor(m => m.Password)
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="col-md-10">
                                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm password" })
                                                @Html.ValidationMessageFor(m => m.ConfirmPassword)
                                            </div>
                                        </div>
                                        @*<div class="form-group">
                                            <div class="col-md-10">
                                                @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "Confirm password" })
                                                @Html.ValidationMessageFor(m => m.)
                                            </div>
                                        </div>*@

                                        <div class="footer text-center">
                                            <input type="submit" class="btn btn-fill btn-danger btn-wd" value="Sign up *" />
                                            <a href="Login" class="btn btn-fill btn-disabled" value="Already Registered?">Existing user?</a>
                                            <br /><br />
                                            <div class="media-body"><center>* By creating an account, you are agreeing to our Terms & Conditions</center></div>
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/jqueryval")
</html>