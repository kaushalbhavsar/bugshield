@model BUGSKAN.Portal.Models.ForgotPasswordViewModel


@{
    ViewBag.Title = "Log in";
    Layout = "~/Views/Shared/_Outer.cshtml";

}
<div class="wrapper wrapper-full-page">
    <div class="full-page login-page" data-color="rose">
        <div class="content">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 col-sm-6 col-md-offset-4 col-sm-offset-3">

                        <section id="loginForm">
                            @using (Html.BeginForm("ForgotPassword", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="card card-login card-hidden">
                                    <div class="header text-center">
                                        <img src="/assets/img/logo.png" width="180" style="width:250px;" />
                                    </div>
                                    <div class="content">
                                      
                                        <div class="form-group">
                                            @Html.LabelFor(m => m.Email)

                                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control input-no-border", @placeholder = "Your email ID" })

                                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })


                                            <div class="text-danger" align="center">
                                                @ViewBag.MsgForForgotPass
                                            </div>

                                        </div>

                                        <div class="text-center">
                                            <input type="submit" class="btn btn-rose btn-wd btn-lg" value="Submit" />
                                        </div>

                                    </div>
                                </div>
                            }


                        </section>


                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

@*@section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }*@






