# Copy to backend/.env or export before starting the API.
DATABASE_URL=postgresql+psycopg://bugshield:bugshield@127.0.0.1:5432/bugshield
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SESSION_TTL_HOURS=12
MAX_UPLOAD_BYTES=10485760
MAX_EVENT_BYTES=524288
MAX_EVENTS_PER_REQUEST=200
INGEST_RATE_LIMIT_PER_MINUTE=120
DEFAULT_RETENTION_DAYS=90
DEFAULT_TIMEZONE=UTC
